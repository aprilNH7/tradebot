# =============================================================================
# TradeBot Configuration — Copy to .env and fill in your keys
# =============================================================================

# --- Binance ---
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# --- Coinbase ---
COINBASE_API_KEY=
COINBASE_SECRET_KEY=
COINBASE_PASSPHRASE=

# --- Alpaca (Stocks) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# For live: https://api.alpaca.markets

# --- OANDA (Forex) ---
OANDA_ACCOUNT_ID=
OANDA_ACCESS_TOKEN=
OANDA_ENVIRONMENT=practice
# For live: live

# --- General ---
LOG_LEVEL=INFO
DASHBOARD_PORT=5050
SCAN_INTERVAL=60
# Candle timeframe used by all strategies: 1m, 5m, 15m, 1h, 1d
CANDLE_TIMEFRAME=1h

# --- Watchlists (comma-separated; leave blank to use defaults) ---
STOCK_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA,NVDA,META,AMD,NFLX,SPY,QQQ,JPM,V,DIS,COIN,PLTR,UBER,BA,INTC,SOFI
CRYPTO_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,AVAX/USDT,LINK/USDT,DOT/USDT
FOREX_PAIRS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD,USD_CHF,NZD_USD,EUR_GBP

# --- Risk Management ---
# Stop trading entirely once this drawdown is hit
RISK_MAX_DRAWDOWN=0.10
# Max % of portfolio per single position
RISK_MAX_POSITION_SIZE=0.05
RISK_STOP_LOSS_PCT=0.02
RISK_TAKE_PROFIT_PCT=0.04
RISK_MAX_DAILY_TRADES=50
RISK_MAX_OPEN_POSITIONS=10
# Signals below this confidence are ignored (0.0–1.0)
RISK_MIN_CONFIDENCE=0.30
# Hard dollar floor for a single day's loss, measured against opening equity
RISK_MAX_DAILY_LOSS=200

# --- Order Execution ---
# "limit" (default) posts passively; "market" crosses the spread
ENTRY_ORDER_TYPE=limit
# "passive" rests at bid/ask; "mid" splits the spread
LIMIT_PRICE_MODE=passive
# Seconds to leave a resting entry order before cancelling it
LIMIT_ENTRY_TIMEOUT=20

# --- Strategy Tuning ---
SMA_FAST_PERIOD=9
SMA_SLOW_PERIOD=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
GRID_LEVELS=10
GRID_SPACING_PCT=0.005
ARBITRAGE_MIN_SPREAD_PCT=0.005
